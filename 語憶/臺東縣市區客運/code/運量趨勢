```{r}
library(lubridate)
library(dplyr)
library(data.table)



path <- "C:/Users/AVITA/Downloads/臺東縣公車.csv"
data <- read.csv(path, stringsAsFactors = FALSE)

date1 <- ymd(data$資料代表日期.yyyy.MM.dd.)
year1 <- year(date1)
year_select <- year1[year1 %in% c(2023, 2024, 2025)]
tk_table <- table(year_select)

year_value <- as.numeric(names(tk_table))
ride_count <- as.numeric(tk_table)

roc_year <- year_value - 1911

png(
  filename = "C:/Users/AVITA/Downloads/112年至114年臺東縣市區客運運量趨勢折線圖.png",
  width = 12,
  height = 6,
  units = "in",
  res = 300
)

windowsFonts(kai = windowsFont("Microsoft JhengHei"))
par(family = "kai", mar = c(5,6,4,10))

plot(
  x = roc_year,
  y = ride_count,
  type = "o",
  pch = 16,
  lwd = 2,
  col = "gray",
  xlab = "年份",
  ylab = "搭乘次數",
  ylim = c(min(ride_count)*0.9, max(ride_count)*1.2),
  xlim = c(min(roc_year)-0.1, max(roc_year)+0.1),
  cex.main = 2,
  cex.lab = 2,
  cex.axis = 1.5,
  xaxt = "n",
  yaxt = "n",
  bty = "n"
)

title(
  main = "112年至114年臺東縣市區客運運量趨勢折線圖",
  cex.main = 2,
  adj = 0
)

axis(1, at = roc_year, labels = roc_year, cex.axis = 1.5)

text(
  x = roc_year,
  y = ride_count + max(ride_count)*0.02,
  labels = format(ride_count, big.mark = ","),
  pos = 3,
  cex = 1.5
)

grid()

dev.off()

```

